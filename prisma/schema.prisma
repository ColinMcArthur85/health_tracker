// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl = env("DATABASE_URL_UNPOOLED")
}

model DailyLog {
  id        String   @id @default(uuid())
  date      DateTime @unique // YYYY-MM-DDT00:00:00.000Z
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Summary stats (optional, can be calculated but good for caching)
  rating    Float?

  // Relations
  workouts      Workout[]
  nutrition     Nutrition?
  checkIn       CheckIn?
  reflections   Reflection[]
  photos        Photo[]
  measurements  Measurement[]

  medications   Medication[]
  dreams        Dream[]
  protocolLogs  ProtocolLog[]
}

model Dream {
  id          String   @id @default(uuid())
  dailyLogId  String
  dailyLog    DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  
  content     String
  mood        String?
  tags        String?  // Comma separated tags
  analysis    String?  // AI analysis result
  
  createdAt   DateTime @default(now())
}

model Photo {
  id          String   @id @default(uuid())
  dailyLogId  String
  dailyLog    DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  
  url         String   // Path to stored file
  view        String   @default("FRONT") // FRONT, SIDE, BACK
  caption     String?
  analysis    String?  // AI analysis result (Markdown/JSON)
  createdAt   DateTime @default(now())

  @@index([dailyLogId, view])
}

model Workout {
  id          String   @id @default(uuid())
  dailyLogId  String
  dailyLog    DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  
  name        String?
  instructor  String?
  platform    String?
  duration    Int?     // in minutes
  type        String?  // Mobility, Strength, Cardio, etc.
  focusArea   String?
  intensity   String?  // Low, Moderate, High
  notes       String?

  @@index([dailyLogId])
}

model Nutrition {
  id          String   @id @default(uuid())
  dailyLogId  String   @unique
  dailyLog    DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  calories    Int?
  protein     Int?
  carbs       Int?
  fat         Int?
  fiber       Int?
  
  // JSON blob for detailed micros or specific meals if we want flexibility
  mealsJson   String?  // Storing structured meal data as JSON
  microsJson  String?  // Storing micronutrients as JSON
  
  // Relations
  foodItems   FoodItem[]  // Individual food items with API data
}

model FoodItem {
  id           String    @id @default(uuid())
  nutritionId  String
  nutrition    Nutrition @relation(fields: [nutritionId], references: [id], onDelete: Cascade)
  
  name         String
  fdcId        String?   // USDA FoodData Central ID
  servingSize  Float?    // Amount of serving
  servingUnit  String?   // Unit (g, oz, cup, etc.)
  
  calories     Int?
  protein      Int?
  carbs        Int?
  fat          Int?
  fiber        Int?
  
  createdAt    DateTime  @default(now())

  @@index([nutritionId])
}

model CheckIn {
  id          String   @id @default(uuid())
  dailyLogId  String   @unique
  dailyLog    DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  sleepHours  Float?
  weight      Float?
  water       Int?     // in ml
  caffeine    String?
  alcohol     String?
  supplements String?
  pain        String?
  notes       String?

  @@index([weight])
  @@index([sleepHours])
}

model Reflection {
  id          String   @id @default(uuid())
  dailyLogId  String
  dailyLog    DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  
  time        DateTime? // Specific time of reflection
  type        String?   // "Post-Workout", "Morning", "Evening", "Ad-hoc"
  
  mood        String?
  energy      String?
  confidence  String?
  notes       String?

  @@index([dailyLogId])
}

model Measurement {
  id          String   @id @default(uuid())
  dailyLogId  String
  dailyLog    DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  
  // Body measurements in cm
  chest       Float?
  waist       Float?
  hips        Float?
  leftArm     Float?
  rightArm    Float?
  leftThigh   Float?
  rightThigh  Float?
  leftCalf    Float?
  rightCalf   Float?
  neck        Float?
  shoulders   Float?
  
  notes       String?

  @@index([dailyLogId])
}

model Medication {
  id          String   @id @default(uuid())
  dailyLogId  String
  dailyLog    DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  
  name        String
  dosage      String?
  time        DateTime?
  taken       Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([dailyLogId])
}

model Protocol {
  id          String   @id @default(uuid())
  name        String   // e.g., "Testosterone Optimization"
  substance   String   // e.g., "Clomiphene"
  dosage      String   // e.g., "25mg"
  frequency   String   // e.g., "E3D", "Daily"
  startDate   DateTime @default(now())
  status      String   @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED
  notes       String?
  
  logs        ProtocolLog[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model ProtocolLog {
  id          String   @id @default(uuid())
  protocolId  String
  protocol    Protocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  
  dailyLogId  String?
  dailyLog    DailyLog? @relation(fields: [dailyLogId], references: [id], onDelete: SetNull)
  
  date        DateTime @default(now())
  taken       Boolean  @default(true)
  
  // Side effects tracking (Stop Signals)
  headache    Int?     // 1-5 scale
  anxiety     Int?     // 1-5 scale
  sleepQuality Int?    // 1-5 scale
  mood        Int?     // 1-5 scale
  
  notes       String?
  createdAt   DateTime @default(now())

  @@index([protocolId])
  @@index([dailyLogId])
}
